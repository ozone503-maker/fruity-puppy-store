{
  "name": "store-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node tools/dev.js",
    "check": "node tools/check-store.js",
    "test": "node --test test/printify.test.js test/fulfillment.test.js test/stripe.test.js test/merch-factory.test.js",
    "import:shopify": "node tools/import-shopify.js",
    "merch": "node tools/merch-factory.js",
    "merch:dry": "node tools/merch-factory.js --dry-run --blueprint 6 --provider 3 --colors \"Solid Black\" --sizes S,M,L --title \"Fruity Puppy Tee\"",
    "lint": "node tools/syntax-check.js"
  }
}
